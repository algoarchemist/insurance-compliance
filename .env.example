# App
APP_NAME=Sugamai
APP_ENV=development
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://sugamai:sugamai@localhost:5432/sugamai_db
REDIS_URL=redis://localhost:6379/0

# MinIO (document storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sugamai
MINIO_SECRET_KEY=
MINIO_BUCKET_DOCUMENTS=sugamai-docs
MINIO_SECURE=false

# UIDAI (Aadhaar) — sandbox
UIDAI_AUTH_URL=https://stage1.uidai.gov.in/authserver/2.5
UIDAI_AUA_CODE=
UIDAI_LICENSE_KEY=

# ABDM (ABHA) — sandbox
ABDM_BASE_URL=https://sandbox.abdm.gov.in/api/v3
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# NHCX — sandbox
NHCX_BASE_URL=https://dev.hcxprotocol.io/api/v0.7
NHCX_PARTICIPANT_CODE=
NHCX_AUTH_TOKEN=
NHCX_ENCRYPTION_CERT=

# NHA (PMJAY)
NHA_BASE_URL=https://pmjay.gov.in/api
NHA_API_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# SMS (OTP delivery)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Bank Penny Drop
PENNY_DROP_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_APP_NAME=Sugamai
